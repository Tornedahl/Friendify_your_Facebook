{
  "manifest_version": 3,
  "name": "Friendify",
  "version": "1.0.0",
  "description": "Always opens Facebook in the friends feed instead of Home.",
  "permissions": ["declarativeNetRequest", "webNavigation"],
  "host_permissions": ["*://*.facebook.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "friends-feed",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
