{
  "manifest_version": 3,
  "name": "Friendify",
  "version": "1.0.0",
  "description": "\u00d6ppnar alltid Facebook i v\u00e4nfl\u00f6det i st\u00e4llet f\u00f6r Hem.",
  "permissions": ["declarativeNetRequest", "webNavigation"],
  "host_permissions": ["*://*.facebook.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "vanflode",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
